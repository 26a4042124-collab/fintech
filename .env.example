FLASK_SECRET_KEY=thay_bang_chuoi_ngau_nhien_dai
FLASK_ENV=development

# Gmail SMTP — Cấu hình gửi OTP (Điền thông tin khi triển khai)
# Hướng dẫn lấy App Password: https://myaccount.google.com/apppasswords
MAIL_SENDER=your_email@hvnh.edu.vn
MAIL_PASSWORD=your_app_password_here

# Google Gemini API — Dùng cho AI Vision OCR & Hybrid RAG Chatbot
# Lấy API key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# Fernet AES Encryption Key — Mã hóa Open Banking Access Token (NĐ 13/2023/NĐ-CP)
# Sinh key bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FINLAB_CRYPTO_KEY=your_fernet_base64_key_here
